extends ../../layouts/section/tpl.pug

block variables
  - sectionClass = 'vacancy'
  - sectionID = 'vacancies'
  - sectionContainerClass = ''
  - sectionLabel = { text: 'Работа у нас', class: 'label--bordered label--dotted' }
  - sectionTitle = 'Вакансии'
  - sectionText = `<p>Добро пожаловать в академию водных искусств!</p><p>Присоединяйся к нам и помоги вдохновить будущее поколение на спортивные достижения в водных искусствах!</p>`

block content
  include ../../components/base-slider/tpl.pug

  +base-slider({
    type: 'vacancy',
    navigation: true,

    items: [
      {
        title: 'Тренер-преподаватель',

        text: '- Опыт от 3 лет <br> - Звание не ниже мастера спорта РФ'
      },
    ]
  })
